<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FModel.ViewModels"
        x:Class="FModel.Mac.Views.Settings.AesManager"
        x:DataType="vm:AesManagerViewModel"
        Title="AES Keys Manager"
        Width="800" Height="500" WindowStartupLocation="CenterOwner"
        Background="#1e1e1e" Foreground="White">
    <Grid RowDefinitions="Auto, *, Auto">
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Main Key" FontWeight="Bold"/>
            <TextBox Text="{Binding MainKey}" Margin="0,5"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Margin="10" ItemsSource="{Binding Keys}" AutoGenerateColumns="False" Background="#252526">
            <DataGrid.Columns>
                <DataGridTextColumn Header="GUID" x:DataType="vm:AesKeyEntry" Binding="{Binding Guid}" Width="*"/>
                <DataGridTextColumn Header="Key" x:DataType="vm:AesKeyEntry" Binding="{Binding Key}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Fetch Keys" Margin="5"/>
            <Button Content="Save" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
